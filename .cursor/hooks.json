{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \".cursor/hooks/architecture-doc-refresh.ps1\" -Mode track",
        "timeout": 10
      }
    ],
    "afterTabFileEdit": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \".cursor/hooks/architecture-doc-refresh.ps1\" -Mode track",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \".cursor/hooks/architecture-doc-refresh.ps1\" -Mode stop",
        "timeout": 15,
        "loop_limit": 1
      }
    ]
  }
}
