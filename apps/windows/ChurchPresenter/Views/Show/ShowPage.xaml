<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ChurchPresenter.Views.ShowPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:showDeck="using:ChurchPresenter.Features.Show.Deck"
    xmlns:showSidebar="using:ChurchPresenter.Features.Show.Sidebar"
    xmlns:showOutput="using:ChurchPresenter.Features.Show.Output"
    xmlns:showMedia="using:ChurchPresenter.Features.Show.MediaDrawer"
    x:Name="RootPage"
    mc:Ignorable="d"
    Background="Transparent">

    <!-- NavigationView pane flush to the window edge; no outer inset Border. MainWindow tab bar is unchanged. -->
    <Grid
        x:Name="LayoutRoot"
        Background="Transparent"
        PointerPressed="LayoutRoot_PointerPressed">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="320" />
            <ColumnDefinition
                x:Name="OutputPanelColumn"
                Width="460"
                MinWidth="360"
                MaxWidth="560" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition x:Name="MediaPanelContentRow" Height="0" />
        </Grid.RowDefinitions>
        <Button
            x:Name="KeyboardFocusTarget"
            Grid.ColumnSpan="2"
            Width="0"
            Height="0"
            Padding="0"
            Margin="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="Transparent"
            BorderThickness="0"
            IsTabStop="True"
            Opacity="0"
            UseSystemFocusVisuals="False" />
        <showSidebar:ShowSidebarView
            x:Name="ShowSidebar"
            Grid.Column="0"
            Grid.Row="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            ViewModel="{x:Bind ViewModel, Mode=OneWay}">
            <showDeck:ShowDeckView
                x:Name="ShowDeck"
                KeyboardFocusTarget="{x:Bind KeyboardFocusTarget}"
                ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
        </showSidebar:ShowSidebarView>
        <showMedia:MediaDrawerView
            x:Name="MediaDrawer"
            Grid.Column="0"
            Grid.Row="1"
            ViewModel="{x:Bind ViewModel, Mode=OneWay}" />

        <showOutput:ShowOutputColumnView
            x:Name="OutputColumn"
            Grid.Column="1"
            Grid.Row="0"
            Grid.RowSpan="2"
            ViewModel="{x:Bind ViewModel, Mode=OneWay}" />

        <Grid
            x:Name="ExportRenderHost"
            Grid.ColumnSpan="2"
            Width="1"
            Height="1"
            Margin="-20000,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsHitTestVisible="False" />

        <Grid
            x:Name="PresentationDragPreviewHost"
            Grid.ColumnSpan="2"
            Width="320"
            Height="160"
            Margin="-20000,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsHitTestVisible="False" />

    </Grid>
</Page>
