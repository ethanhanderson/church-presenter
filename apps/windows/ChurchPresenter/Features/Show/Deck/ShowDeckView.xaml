                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                    FontSize="14"
                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                    Glyph="&#xE8A9;"
                                                    Visibility="{x:Bind ViewModel.ShowThumbnailMode, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                            </Grid>
                                        </Grid>
                                    </Button>
                                    <Border
                                        Grid.Column="1"
                                        Width="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Stretch"
                                        Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                                    <Button
                                        Grid.Column="2"
                                        AutomationProperties.Name="Text view"
                                        Click="TextViewToggle_Click"
                                        CornerRadius="0"
                                        Style="{StaticResource ShowDeckViewModeSegmentButtonStyle}"
                                        ToolTipService.ToolTip="Text-only cards">
                                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                            <Border
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                CornerRadius="0"
                                                Visibility="{x:Bind ViewModel.ShowTextMode, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                            <Grid
                                                Padding="10,8"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                                <FontIcon
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                    FontSize="14"
                                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                    Glyph="&#xE8D2;"
                                                    Visibility="{x:Bind ViewModel.ShowTextMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert, Mode=OneWay}" />
                                                <FontIcon
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                    FontSize="14"
                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                    Glyph="&#xE8D2;"
                                                    Visibility="{x:Bind ViewModel.ShowTextMode, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                            </Grid>
                                        </Grid>
                                    </Button>
                                    <Border
                                        Grid.Column="3"
                                        Width="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Stretch"
                                        Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                                    <Button
                                        Grid.Column="4"
                                        AutomationProperties.Name="List view"
                                        Click="ListViewToggle_Click"
                                        CornerRadius="0,4,4,0"
                                        Style="{StaticResource ShowDeckViewModeSegmentButtonStyle}"
                                        ToolTipService.ToolTip="List with thumbnail">
                                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                            <Border
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                CornerRadius="0,4,4,0"
                                                Visibility="{x:Bind ViewModel.ShowListMode, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                            <Grid
                                                Padding="10,8"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                                <FontIcon
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                    FontSize="14"
                                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                    Glyph="&#xE8FD;"
                                                    Visibility="{x:Bind ViewModel.ShowListMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert, Mode=OneWay}" />
                                                <FontIcon
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                    FontSize="14"
                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                    Glyph="&#xE8FD;"
                                                    Visibility="{x:Bind ViewModel.ShowListMode, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                            </Grid>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Divider -->
                            <Border
                                Width="1"
                                Height="18"
                                Margin="4,0"
                                VerticalAlignment="Center"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                                       <!-- Card size slider -->
                            <Slider
                                x:Name="DeckScaleSlider"
                                Width="120"
                                VerticalAlignment="Center"
                                Maximum="4"
                                Minimum="0"
                                SnapsTo="StepValues"
                                StepFrequency="1"
                                TickFrequency="1"
                                TickPlacement="None"
                                Value="{x:Bind ViewModel.DeckScaleStep, Mode=OneWay}"
                                ValueChanged="DeckScaleSlider_ValueChanged" />

                            <!-- Divider -->
                            <Border
                                Width="1"
                                Height="18"
                                Margin="4,0"
                                VerticalAlignment="Center"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <!-- Combined options: group by section + thumbnail background -->
                            <Button
                                x:Name="DeckOptionsButton"
                                Width="34"
                                Height="30"
                                Padding="0"
                                AutomationProperties.Name="Slide layout options"
                                ToolTipService.ToolTip="Slide layout options">
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE712;" />
                                <Button.Flyout>
                                    <Flyout
                                        x:Name="DeckOptionsFlyout"
                                        Placement="TopEdgeAlignedRight">
                                        <StackPanel MinWidth="260" Spacing="12">

                                            <!-- Slide layout: lyric group headers -->
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                                <TextBlock
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Text="Show lyric group headers" />
                                                <ToggleSwitch
                                                    Grid.Column="1"
                                                    x:Name="GroupBySectionSwitch"
                                                    MinWidth="0"
                                                    Margin="0,0,-8,0"
                                                    AutomationProperties.Name="Show lyric group headers"
                                                    ToolTipService.ToolTip="Switch between the standard slide layout and lyric group header layout"
                                                    IsOn="{x:Bind ViewModel.GroupBySection, Mode=TwoWay}" />
                                            </Grid>

                                            <!-- Divider -->
                                            <Border
                                                Height="1"
                                                Margin="-20,0"
                                                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                            <!-- Slide backgrounds: master toggle, then picker swatch (full RGB from picker) -->
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                                <TextBlock
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Text="Slide backgrounds" />
                                                <ToggleSwitch
                                                    Grid.Column="1"
                                                    x:Name="SlideBackgroundSwitch"
                                                    MinWidth="0"
                                                    Margin="0,0,-8,0"
                                                    IsOn="{x:Bind ViewModel.TransparentThumbnailBackgroundEnabled, Mode=OneWay}"
                                                    Toggled="SlideBackgroundSwitch_Toggled" />
                                            </Grid>

                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <TextBlock
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="Background color" />
                                                <Button
                                                    Grid.Column="1"
                                                    x:Name="ThumbnailBgColorButton"
                                                    Width="32"
                                                    Height="28"
                                                    Padding="0"
                                                    HorizontalContentAlignment="Stretch"
                                                    VerticalContentAlignment="Stretch"
                                                    Style="{StaticResource ShowDeckColorSwatchButtonStyle}"
                                                    AutomationProperties.Name="Choose slide background color"
                                                    ToolTipService.ToolTip="Choose slide background color">
                                                    <Button.Background>
                                                        <SolidColorBrush Color="{x:Bind ViewModel.TransparentThumbnailColorWinUI, Mode=OneWay}" />
                                                    </Button.Background>
                                                    <Button.Flyout>
                                                        <Flyout
                                                            x:Name="ThumbnailBgColorFlyout"
                                                            Opening="ThumbnailBgColorFlyout_Opening"
                                                            Placement="TopEdgeAlignedRight">
                                                            <StackPanel MinWidth="240" Spacing="10">
                                                                <ColorPicker
                                                                    x:Name="ThumbnailBgColorPicker"
                                                                    ColorSpectrumShape="Box"
                                                                    IsAlphaEnabled="False"
                                                                    IsColorChannelTextInputVisible="False"
                                                                    IsColorPreviewVisible="False"
                                                                    IsMoreButtonVisible="False"
                                                                    IsHexInputVisible="False"
                                                                    ColorChanged="ThumbnailBgColorPicker_ColorChanged" />
                                                                <!-- Opacity -->
                                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                                    <TextBlock
                                                                        Grid.Column="0"
                                                                        VerticalAlignment="Center"
                                                                        FontSize="13"
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        Text="Opacity" />
                                                                    <Slider
                                                                        Grid.Column="1"
                                                                        x:Name="DeckOpacitySlider"
                                                                        VerticalAlignment="Center"
                                                                        Maximum="100"
                                                                        Minimum="0"
                                                                        StepFrequency="1"
                                                                        TickPlacement="None"
                                                                        Value="{x:Bind ViewModel.TransparentThumbnailOpacity, Mode=OneWay}"
                                                                        ValueChanged="DeckOpacitySlider_ValueChanged" />
                                                                    <TextBlock
                                                                        Grid.Column="2"
                                                                        Width="32"
                                                                        VerticalAlignment="Center"
                                                                        FontSize="13"
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        Text="{x:Bind ViewModel.TransparentThumbnailOpacity, Mode=OneWay}"
                                                                        TextAlignment="Right" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </Grid>

                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
    </Grid>
</UserControl>
