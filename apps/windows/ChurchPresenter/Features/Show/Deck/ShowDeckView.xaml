                                    <TextBlock
                                        Grid.Column="0"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{x:Bind FooterForegroundBrush, Mode=OneWay}"
                                        Text="{x:Bind Ordinal}"
                                        TextLineBounds="Tight" />
                                    <TextBlock
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{x:Bind FooterForegroundBrush, Mode=OneWay}"
