                                Text="{x:Bind SlideTransitionOverrideBadgeText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Button>
        </DataTemplate>
        </ResourceDictionary>
