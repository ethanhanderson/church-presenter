<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ChurchPresenter.Features.Show.Deck.ShowDeckView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ChurchPresenter.Controls"
    xmlns:converters="using:ChurchPresenter.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ChurchPresenter.ViewModels"
    xmlns:windowsui="using:Windows.UI"
    x:Name="ShowDeckRoot"
    mc:Ignorable="d"
    Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ShowChromeDividerBrush" Color="#1A000000" />
                    <SolidColorBrush x:Key="ShowSlideDeckLiveOutlineBrush" Color="#FF22C55E" />
                    <windowsui:Color x:Key="ShowLayerAcrylicTintColor">#FFFFFFFF</windowsui:Color>
                    <windowsui:Color x:Key="ShowLayerAcrylicFallbackColor">#FFEDEDED</windowsui:Color>
                    <AcrylicBrush x:Key="ShowBrowseDeckHeaderAcrylicBrush" FallbackColor="{StaticResource ShowLayerAcrylicFallbackColor}" TintColor="{StaticResource ShowLayerAcrylicTintColor}" TintLuminosityOpacity="0.88" TintOpacity="0.78" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ShowChromeDividerBrush" Color="#1A000000" />
                    <SolidColorBrush x:Key="ShowSlideDeckLiveOutlineBrush" Color="#FF22C55E" />
                    <windowsui:Color x:Key="ShowLayerAcrylicTintColor">#FFFFFFFF</windowsui:Color>
                    <windowsui:Color x:Key="ShowLayerAcrylicFallbackColor">#FFEDEDED</windowsui:Color>
                    <AcrylicBrush x:Key="ShowBrowseDeckHeaderAcrylicBrush" FallbackColor="{StaticResource ShowLayerAcrylicFallbackColor}" TintColor="{StaticResource ShowLayerAcrylicTintColor}" TintLuminosityOpacity="0.88" TintOpacity="0.78" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ShowChromeDividerBrush" Color="#0FFFFFFF" />
                    <SolidColorBrush x:Key="ShowSlideDeckLiveOutlineBrush" Color="#FF22C55E" />
                    <windowsui:Color x:Key="ShowLayerAcrylicTintColor">#FF323232</windowsui:Color>
                    <windowsui:Color x:Key="ShowLayerAcrylicFallbackColor">#FF1E1E1E</windowsui:Color>
                    <AcrylicBrush x:Key="ShowBrowseDeckHeaderAcrylicBrush" FallbackColor="{StaticResource ShowLayerAcrylicFallbackColor}" TintColor="{StaticResource ShowLayerAcrylicTintColor}" TintLuminosityOpacity="0.88" TintOpacity="0.78" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <converters:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:MillisecondsToSecondsLabelConverter x:Key="MsToSecondsLabelConverter" />
        <DataTemplate x:Key="SlideGroupMenuItemTemplate">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border
                    Width="12"
                    Height="12"
                    VerticalAlignment="Center"
                    Background="{Binding Brush}"
                    CornerRadius="3" />
                <TextBlock
                    VerticalAlignment="Center"
                    Text="{Binding Label}" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="SlideGroupMenuFlyoutItemStyle" TargetType="MenuFlyoutItem">
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuFlyoutItem">
                        <Grid
                            x:Name="Root"
                            MinHeight="{TemplateBinding MinHeight}"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentControl
                                Content="{TemplateBinding Tag}"
                                ContentTemplate="{StaticResource SlideGroupMenuItemTemplate}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="SlideContextNoThemeItemTemplate">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border
                    Width="72"
                    Height="40"
                    Background="Black"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="5">
                    <Grid>
                        <Grid
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            ColumnDefinitions="*,*,*,*,*,*,*,*"
                            RowDefinitions="*,*,*,*">
                            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
                            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
                            <Rectangle Grid.Row="0" Grid.Column="4" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
                            <Rectangle Grid.Row="0" Grid.Column="6" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
                            <Rectangle Grid.Row="1" Grid.Column="1" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
                            <Rectangle Grid.Row="1" Grid.Column="3" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
                            <Rectangle Grid.Row="1" Grid.Column="5" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
                            <Rectangle Grid.Row="1" Grid.Column="7" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
                            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
                            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
                            <Rectangle Grid.Row="2" Grid.Column="4" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
                            <Rectangle Grid.Row="2" Grid.Column="6" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
                            <Rectangle Grid.Row="3" Grid.Column="1" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
                            <Rectangle Grid.Row="3" Grid.Column="3" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
                            <Rectangle Grid.Row="3" Grid.Column="5" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
                            <Rectangle Grid.Row="3" Grid.Column="7" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
                        </Grid>
                        <Border
                            Width="24"
                            Height="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE711;" />
                        </Border>

                    </Grid>
                </Border>

                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{Binding}" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="SlideContextNoThemeMenuFlyoutItemStyle" TargetType="MenuFlyoutItem">
            <Setter Property="MinWidth" Value="320" />
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuFlyoutItem">
                        <Grid
                            x:Name="Root"
                            MinHeight="{TemplateBinding MinHeight}"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0.72" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentControl
                                Content="{TemplateBinding Tag}"
                                ContentTemplate="{StaticResource SlideContextNoThemeItemTemplate}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <CollectionViewSource
            x:Key="SlideDeckGroupedSource"
            IsSourceGrouped="True"
            ItemsPath="SlideRows"
            Source="{x:Bind ViewModel.SlideDeckGroupedSections, Mode=OneWay}" />
        <DataTemplate x:Key="ShowSlideDeckGroupHeaderTemplate">
            <TextBlock
                Margin="0,18,0,10"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Text="{Binding Title}" />
        </DataTemplate>
        <Style
            x:Key="ShowGroupedDeckGridItemContainerStyle"
            BasedOn="{StaticResource DefaultGridViewItemStyle}"
            TargetType="GridViewItem">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style
            x:Key="ShowGroupedDeckListItemContainerStyle"
            BasedOn="{StaticResource DefaultListViewItemStyle}"
            TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <!-- Swatch: default Button template layers theme chrome over Background; this template paints Background on the root Border. -->
        <Style x:Key="ShowDeckColorSwatchButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- No ContentPresenter: default presenter can paint over TemplateBinding Background. -->
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Deck view mode: segments; hover fill uses TemplateBinding CornerRadius (set per segment to match outer Border radius 4). -->
        <Style x:Key="ShowDeckViewModeSegmentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="RootBorder"
                            Background="Transparent"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <Grid>
                                <Border
                                    x:Name="HoverBackground"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Background="Transparent"
                                    CornerRadius="{TemplateBinding CornerRadius}" />
                                <ContentPresenter
                                    x:Name="ContentPresenter"
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTransitions="{TemplateBinding ContentTransitions}" />
                            </Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="HoverBackground.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="HoverBackground.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Opacity" Value="0.5" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ShowSlideDeckCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="ShowSlideDeckCardTemplate" x:DataType="vm:ShowSlideDeckItem">
            <Button
                AllowDrop="True"
                AutomationProperties.Name="{x:Bind FooterLabel, Mode=OneWay}"
                Click="SlideDeckItem_Click"
                DragOver="SlideDeckItem_DragOver"
                Drop="SlideDeckItem_Drop"
                Opacity="{x:Bind CardOpacity, Mode=OneWay}"
                RightTapped="SlideDeckItem_RightTapped"
                Style="{StaticResource ShowSlideDeckCardButtonStyle}"
                Tag="{x:Bind}"
                x:Name="SlideDeckCardHost">
                <Button.ContextFlyout>
                    <MenuFlyout Opening="SlideDeckItemMenu_Opening" />
                </Button.ContextFlyout>
                <!-- Uniform: logical 228×H design scales as one unit to fill each grid cell (rows use full width; 8px gaps preserved). -->
                <Viewbox HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Stretch="Uniform">
                    <Grid
                        Width="{x:Bind ThumbnailCardOuterWidth, Mode=OneWay}"
                        Height="{x:Bind ThumbnailCardOuterHeight, Mode=OneWay}">
                        <Border
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                            BorderThickness="6"
                            CornerRadius="11"
                            Canvas.ZIndex="1"
                            Visibility="{x:Bind ShowSelectedOutline, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                        <Border
                            BorderBrush="{ThemeResource ShowSlideDeckLiveOutlineBrush}"
                            BorderThickness="2"
                            CornerRadius="6"
                            Margin="6"
                            Canvas.ZIndex="2"
                            Visibility="{x:Bind ShowLiveSlideOutputOutline, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                        <Border
                            Margin="6"
                            Background="{x:Bind ThumbnailContainerBrush, Mode=OneWay}"
                            BorderThickness="0"
                            CornerRadius="6">
                            <Grid
                                Width="{x:Bind ThumbnailCardInnerWidth, Mode=OneWay}"
                                Height="{x:Bind ThumbnailCardInnerHeight, Mode=OneWay}"
                                RowDefinitions="Auto,Auto">
                                <Border
                                    Grid.Row="0"
                                    Width="{x:Bind ThumbnailPreviewWidth, Mode=OneWay}"
                                    Height="{x:Bind ThumbnailPreviewHeight, Mode=OneWay}"
                                    Margin="4,4,4,0"
                                    CornerRadius="5"
                                    VerticalAlignment="Top">
                                    <controls:SlideDeckThumbnailSurface
                                        BackdropBrush="{x:Bind ThumbnailBackdropBrush, Mode=OneWay}"
                                        CheckerboardBrush="{x:Bind ThumbnailCheckerboardBrush, Mode=OneWay}"
                                        ImageStretch="Uniform"
                                        ShowsBackdrop="{x:Bind ThumbnailShowsBackdrop, Mode=OneWay}"
                                        ShowsCheckerboard="{x:Bind ThumbnailShowsCheckerboard, Mode=OneWay}"
                                        SlideImage="{x:Bind Thumbnail, Mode=OneWay}"
                                        UseInstantImageSwap="{x:Bind ThumbnailPreviewInstantSwap, Mode=OneWay}" />
                                </Border>
                                <Grid
                                    Grid.Row="1"
                                    Height="{x:Bind ThumbnailFooterHeight, Mode=OneWay}"
                                    Padding="12,5,12,5"
                                    VerticalAlignment="Top">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{x:Bind FooterForegroundBrush, Mode=OneWay}"
                                            Text="{x:Bind Ordinal}"
                                            TextLineBounds="Tight" />
                                        <TextBlock
                                            Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{x:Bind FooterForegroundBrush, Mode=OneWay}"
                                            Text="{x:Bind FooterLabel}"
                                            TextLineBounds="Tight"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{x:Bind ShowFooterSectionLabel, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                        <Border
                            Margin="10"
                            Padding="6,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="#B3000000"
                            CornerRadius="4"
                            Visibility="{x:Bind IsDisabled, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                            <TextBlock
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="Disabled" />
                        </Border>
                        <Border
                            Margin="10"
                            Padding="6,2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="4"
                            Visibility="{x:Bind HasSlideTransitionOverride, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    FontSize="10"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Glyph="&#xE15A;" />
                                <TextBlock
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Text="{x:Bind SlideTransitionOverrideBadgeText, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Viewbox>
            </Button>
        </DataTemplate>
        <!-- Text-only card: shows slide number + label + raw text; no thumbnail; font size is fixed. -->
        <DataTemplate x:Key="ShowSlideDeckTextCardTemplate" x:DataType="vm:ShowSlideDeckItem">
            <Button
                AllowDrop="True"
                AutomationProperties.Name="{x:Bind FooterLabel, Mode=OneWay}"
                Click="SlideDeckItem_Click"
                DragOver="SlideDeckItem_DragOver"
                Drop="SlideDeckItem_Drop"
                Opacity="{x:Bind CardOpacity, Mode=OneWay}"
                RightTapped="SlideDeckItem_RightTapped"
                Style="{StaticResource ShowSlideDeckCardButtonStyle}"
                Tag="{x:Bind}">
                <Button.ContextFlyout>
                    <MenuFlyout Opening="SlideDeckItemMenu_Opening" />
                </Button.ContextFlyout>
                <Grid>
                    <Border
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="6"
                        CornerRadius="11"
                        Canvas.ZIndex="1"
                        Visibility="{x:Bind ShowSelectedOutline, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                    <Border
                        BorderBrush="{ThemeResource ShowSlideDeckLiveOutlineBrush}"
                        BorderThickness="2"
                        CornerRadius="6"
                        Margin="6"
                        Canvas.ZIndex="2"
                        Visibility="{x:Bind ShowLiveSlideOutputOutline, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                    <Border
                        Margin="6"
                        Background="{x:Bind ThumbnailContainerBrush, Mode=OneWay}"
                        BorderThickness="0"
                        CornerRadius="6"
                        Padding="10,8">
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock
                                    Grid.Column="0"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{x:Bind FooterForegroundBrush, Mode=OneWay}"
                                    Text="{x:Bind Ordinal}"
                                    TextLineBounds="Tight" />
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{x:Bind FooterForegroundBrush, Mode=OneWay}"
                                    Text="{x:Bind FooterLabel}"
                                    TextLineBounds="Tight"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="{x:Bind ShowFooterSectionLabel, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                            </Grid>
                            <TextBlock
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                LineHeight="18"
                                MaxLines="5"
                                Text="{x:Bind RawText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>
                    <Border
                        Margin="10"
                        Padding="6,2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="#B3000000"
                        CornerRadius="4"
                        Visibility="{x:Bind IsDisabled, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                        <TextBlock
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="Disabled" />
                    </Border>
                    <Border
                        Margin="10"
                        Padding="6,2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="4"
                        Visibility="{x:Bind HasSlideTransitionOverride, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="10"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                Glyph="&#xE15A;" />
                            <TextBlock
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                Text="{x:Bind SlideTransitionOverrideBadgeText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- List-view row: small thumbnail on the left, raw text on the right; row height driven by DeckListItemHeight. -->
        <DataTemplate x:Key="ShowSlideDeckListItemTemplate" x:DataType="vm:ShowSlideDeckItem">
            <Button
                AllowDrop="True"
                AutomationProperties.Name="{x:Bind FooterLabel, Mode=OneWay}"
                Click="SlideDeckItem_Click"
                DragOver="SlideDeckItem_DragOver"
                Drop="SlideDeckItem_Drop"
                Opacity="{x:Bind CardOpacity, Mode=OneWay}"
                RightTapped="SlideDeckItem_RightTapped"
                Style="{StaticResource ShowSlideDeckCardButtonStyle}"
                Tag="{x:Bind}">
                <Button.ContextFlyout>
                    <MenuFlyout Opening="SlideDeckItemMenu_Opening" />
                </Button.ContextFlyout>
                <Grid Margin="0,1">
                    <Border
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="6"
                        CornerRadius="9"
                        Canvas.ZIndex="1"
                        Visibility="{x:Bind ShowSelectedOutline, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                    <Border
                        BorderBrush="{ThemeResource ShowSlideDeckLiveOutlineBrush}"
                        BorderThickness="2"
                        CornerRadius="5"
                        Margin="6"
                        Canvas.ZIndex="2"
                        Visibility="{x:Bind ShowLiveSlideOutputOutline, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                    <Border
                        Margin="6"
                        Background="{x:Bind ThumbnailContainerBrush, Mode=OneWay}"
                        BorderThickness="0"
                        CornerRadius="5">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="8,6">
                            <!-- Thumbnail -->
                            <Border
                                Grid.Column="0"
                                Width="{x:Bind DeckListThumbWidth, Mode=OneWay}"
                                Height="{x:Bind DeckListItemHeight, Mode=OneWay}"
                                CornerRadius="3">
                                <controls:SlideDeckThumbnailSurface
                                    BackdropBrush="{x:Bind ThumbnailBackdropBrush, Mode=OneWay}"
                                    CheckerboardBrush="{x:Bind DeckListCheckerboardBrush, Mode=OneWay}"
                                    ImageStretch="Uniform"
                                    ShowsBackdrop="{x:Bind ThumbnailShowsBackdrop, Mode=OneWay}"
                                    ShowsCheckerboard="{x:Bind ThumbnailShowsCheckerboard, Mode=OneWay}"
                                    SlideImage="{x:Bind Thumbnail, Mode=OneWay}"
                                    UseInstantImageSwap="{x:Bind ThumbnailPreviewInstantSwap, Mode=OneWay}" />
                            </Border>
                            <!-- Text content -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
