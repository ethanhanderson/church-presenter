<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ChurchPresenter.Features.Show.ShowControls.ShowControlsPanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:ChurchPresenter.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ChurchPresenter.Features.Show.ShowControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:DataType="local:ShowControlsPanelView"
    MinHeight="0"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10" Visibility="{x:Bind ViewModel.ShowControlsAudioSelected, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
            <TextBlock FontWeight="SemiBold" Text="Audio Bin" />
            <ListView Grid.Row="1" MinHeight="120" DisplayMemberPath="Name" ItemsSource="{x:Bind ViewModel.ShowAudioItems, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedAudioCue, Mode=TwoWay}" />
            <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.CreateAudioPlaylistCommand, Mode=OneWay}" Content="New Playlist" />
                <Button Command="{x:Bind ViewModel.TriggerSelectedAudioCueCommand, Mode=OneWay}" Content="Play Audio" IsEnabled="{x:Bind ViewModel.HasSelectedAudioCue, Mode=OneWay}" Style="{ThemeResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10" Visibility="{x:Bind ViewModel.ShowControlsStageSelected, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
            <TextBlock FontWeight="SemiBold" Text="Stage Screens" />
            <ListView Grid.Row="1" MaxHeight="110" DisplayMemberPath="Name" ItemsSource="{x:Bind ViewModel.ShowStageScreens, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedStageScreen, Mode=TwoWay}" />
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <ComboBox HorizontalAlignment="Stretch" DisplayMemberPath="Name" ItemsSource="{x:Bind ViewModel.ShowStageLayouts, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedStageLayout, Mode=TwoWay}" />
                <Button Grid.Column="1" Command="{x:Bind ViewModel.AssignSelectedStageLayoutCommand, Mode=OneWay}" Content="Apply" IsEnabled="{x:Bind ViewModel.HasSelectedStageAssignment, Mode=OneWay}" />
            </Grid>
            <Grid Grid.Row="3" RowDefinitions="Auto,Auto" RowSpacing="8">
                <TextBox Header="Stage message" PlaceholderText="Type a private stage message" Text="{x:Bind ViewModel.StageMessageText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.HideStageMessageCommand, Mode=OneWay}" Content="Hide" />
                    <Button Command="{x:Bind ViewModel.ShowStageMessageCommand, Mode=OneWay}" Content="Show" Style="{ThemeResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10" Visibility="{x:Bind ViewModel.ShowControlsTimersSelected, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
            <TextBlock FontWeight="SemiBold" Text="Timers" />
            <ListView Grid.Row="1" MinHeight="120" DisplayMemberPath="Name" ItemsSource="{x:Bind ViewModel.ShowTimers, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedTimer, Mode=TwoWay}" />
            <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.CreateTimerCommand, Mode=OneWay}" Content="New" />
                <Button Command="{x:Bind ViewModel.ResetSelectedTimerCommand, Mode=OneWay}" Content="Reset" IsEnabled="{x:Bind ViewModel.HasSelectedTimer, Mode=OneWay}" />
                <Button Command="{x:Bind ViewModel.StopSelectedTimerCommand, Mode=OneWay}" Content="Stop" IsEnabled="{x:Bind ViewModel.HasSelectedTimer, Mode=OneWay}" />
                <Button Command="{x:Bind ViewModel.StartSelectedTimerCommand, Mode=OneWay}" Content="Start" IsEnabled="{x:Bind ViewModel.HasSelectedTimer, Mode=OneWay}" Style="{ThemeResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="10" Visibility="{x:Bind ViewModel.ShowControlsMessagesSelected, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
            <TextBlock FontWeight="SemiBold" Text="Messages" />
            <ListView Grid.Row="1" MinHeight="100" DisplayMemberPath="Name" ItemsSource="{x:Bind ViewModel.ShowMessages, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedMessage, Mode=TwoWay}" />
            <TextBox Grid.Row="2" Header="Runtime text / first token" Text="{x:Bind ViewModel.MessageRuntimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
            <StackPanel Grid.Row="3" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.CreateMessageCommand, Mode=OneWay}" Content="New" />
                <Button Command="{x:Bind ViewModel.HideSelectedMessageCommand, Mode=OneWay}" Content="Hide" IsEnabled="{x:Bind ViewModel.HasSelectedMessage, Mode=OneWay}" />
                <Button Command="{x:Bind ViewModel.ShowSelectedMessageCommand, Mode=OneWay}" Content="Show" IsEnabled="{x:Bind ViewModel.HasSelectedMessage, Mode=OneWay}" Style="{ThemeResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10" Visibility="{x:Bind ViewModel.ShowControlsPropsSelected, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
            <TextBlock FontWeight="SemiBold" Text="Props" />
            <GridView Grid.Row="1" MinHeight="120" DisplayMemberPath="Name" ItemsSource="{x:Bind ViewModel.ShowProps, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedProp, Mode=TwoWay}" />
            <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.CreatePropCommand, Mode=OneWay}" Content="New Prop" />
                <Button Command="{x:Bind ViewModel.ToggleSelectedPropCommand, Mode=OneWay}" Content="Toggle Prop" IsEnabled="{x:Bind ViewModel.HasSelectedProp, Mode=OneWay}" Style="{ThemeResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10" Visibility="{x:Bind ViewModel.ShowControlsMacrosSelected, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
            <TextBlock FontWeight="SemiBold" Text="Macros" />
            <GridView Grid.Row="1" MinHeight="120" DisplayMemberPath="Name" ItemsSource="{x:Bind ViewModel.ShowMacros, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedMacro, Mode=TwoWay}" />
            <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.CreateMacroCommand, Mode=OneWay}" Content="New Macro" />
                <Button Command="{x:Bind ViewModel.ExecuteSelectedMacroCommand, Mode=OneWay}" Content="Run Macro" IsEnabled="{x:Bind ViewModel.HasSelectedMacro, Mode=OneWay}" Style="{ThemeResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
