<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ChurchPresenter.Features.Show.ShowControls.Pages.ShowControlsMacrosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ChurchPresenter.Features.Show.ShowControls.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:DataType="local:ShowControlsMacrosPage"
    Background="Transparent"
    mc:Ignorable="d">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
        <TextBlock FontWeight="SemiBold" Text="Macros" />
        <GridView Grid.Row="1" MinHeight="120" DisplayMemberPath="Name" ItemsSource="{x:Bind ViewModel.ShowMacros, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedMacro, Mode=TwoWay}" />
        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
            <Button Command="{x:Bind ViewModel.CreateMacroCommand, Mode=OneWay}" Content="New Macro" />
            <Button Command="{x:Bind ViewModel.ExecuteSelectedMacroCommand, Mode=OneWay}" Content="Run Macro" IsEnabled="{x:Bind ViewModel.HasSelectedMacro, Mode=OneWay}" Style="{ThemeResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Page>
