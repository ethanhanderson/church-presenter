<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ChurchPresenter.Features.Show.Output.ShowOutputColumnView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ChurchPresenter.Controls"
    xmlns:converters="using:ChurchPresenter.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:output="using:ChurchPresenter.Features.Show.Output"
    xmlns:showControls="using:ChurchPresenter.Features.Show.ShowControls"
    xmlns:vm="using:ChurchPresenter.ViewModels"
    xmlns:windowsui="using:Windows.UI"
    x:Name="OutputColumnRoot"
    x:DataType="vm:ShowViewModel"
    mc:Ignorable="d"
    Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ShowChromeDividerBrush" Color="#1A000000" />
                    <SolidColorBrush x:Key="ShowOutputPanelResizeHoverBrush" Color="#66000000" />
                    <windowsui:Color x:Key="ShowLayerAcrylicTintColor">#FFFFFFFF</windowsui:Color>
                    <windowsui:Color x:Key="ShowLayerAcrylicFallbackColor">#FFEDEDED</windowsui:Color>
                    <windowsui:Color x:Key="ShowCardAcrylicTintColor">#FFFFFFFF</windowsui:Color>
                    <windowsui:Color x:Key="ShowCardAcrylicFallbackColor">#FFF2F2F2</windowsui:Color>
                    <AcrylicBrush x:Key="ShowOutputPreviewCardAcrylicBrush" FallbackColor="{StaticResource ShowCardAcrylicFallbackColor}" TintColor="{StaticResource ShowCardAcrylicTintColor}" TintLuminosityOpacity="0.9" TintOpacity="0.82" />
                    <AcrylicBrush x:Key="ShowOutputToolbarAcrylicBrush" FallbackColor="{StaticResource ShowLayerAcrylicFallbackColor}" TintColor="{StaticResource ShowLayerAcrylicTintColor}" TintLuminosityOpacity="0.88" TintOpacity="0.72" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ShowChromeDividerBrush" Color="#1A000000" />
                    <SolidColorBrush x:Key="ShowOutputPanelResizeHoverBrush" Color="#66000000" />
                    <windowsui:Color x:Key="ShowLayerAcrylicTintColor">#FFFFFFFF</windowsui:Color>
                    <windowsui:Color x:Key="ShowLayerAcrylicFallbackColor">#FFEDEDED</windowsui:Color>
                    <windowsui:Color x:Key="ShowCardAcrylicTintColor">#FFFFFFFF</windowsui:Color>
                    <windowsui:Color x:Key="ShowCardAcrylicFallbackColor">#FFF2F2F2</windowsui:Color>
                    <AcrylicBrush x:Key="ShowOutputPreviewCardAcrylicBrush" FallbackColor="{StaticResource ShowCardAcrylicFallbackColor}" TintColor="{StaticResource ShowCardAcrylicTintColor}" TintLuminosityOpacity="0.9" TintOpacity="0.82" />
                    <AcrylicBrush x:Key="ShowOutputToolbarAcrylicBrush" FallbackColor="{StaticResource ShowLayerAcrylicFallbackColor}" TintColor="{StaticResource ShowLayerAcrylicTintColor}" TintLuminosityOpacity="0.88" TintOpacity="0.72" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ShowChromeDividerBrush" Color="#0FFFFFFF" />
                    <SolidColorBrush x:Key="ShowOutputPanelResizeHoverBrush" Color="#66FFFFFF" />
                    <windowsui:Color x:Key="ShowLayerAcrylicTintColor">#FF1A1A1A</windowsui:Color>
                    <windowsui:Color x:Key="ShowLayerAcrylicFallbackColor">#FF1E1E1E</windowsui:Color>
                    <windowsui:Color x:Key="ShowCardAcrylicTintColor">#FF1A1A1A</windowsui:Color>
                    <windowsui:Color x:Key="ShowCardAcrylicFallbackColor">#FF242424</windowsui:Color>
                    <AcrylicBrush x:Key="ShowOutputPreviewCardAcrylicBrush" FallbackColor="{StaticResource ShowCardAcrylicFallbackColor}" TintColor="{StaticResource ShowCardAcrylicTintColor}" TintLuminosityOpacity="0.88" TintOpacity="0.78" />
                    <AcrylicBrush x:Key="ShowOutputToolbarAcrylicBrush" FallbackColor="{StaticResource ShowLayerAcrylicFallbackColor}" TintColor="{StaticResource ShowLayerAcrylicTintColor}" TintLuminosityOpacity="0.88" TintOpacity="0.72" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <converters:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <Style x:Key="PreviewTargetGroupHeaderMenuFlyoutItemStyle" TargetType="MenuFlyoutItem">
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="MinHeight" Value="22" />
                <Setter Property="Padding" Value="12,1,12,2" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <!-- Connected SelectorBar header + tab content (EditPage / Microsoft Learn SelectorBar pattern). -->
            <Style x:Key="ShowPanelSelectorBarHostStyle" TargetType="Border">
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Background" Value="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="CornerRadius" Value="8,8,0,0" />
            </Style>
            <Style x:Key="ShowPanelTabContentHostStyle" TargetType="Border">
                <Setter Property="Padding" Value="12" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Background" Value="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="0,0,8,8" />
            </Style>
            <DataTemplate x:Key="ShowOutputClearActionButtonTemplate" x:DataType="vm:ShowClearActionViewModel">
                <Button
                    Margin="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    MinHeight="0"
                    MinWidth="0"
                    Padding="0"
                    AutomationProperties.AutomationId="{x:Bind Id, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind Label, Mode=OneWay}"
                    Command="{x:Bind ExecuteCommand, Mode=OneWay}"
                    IsEnabled="{x:Bind IsActive, Mode=OneWay}"
                    Style="{ThemeResource AccentButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind Label, Mode=OneWay}">
                    <FontIcon
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="17"
                        Glyph="{x:Bind IconGlyph, Mode=OneWay}" />
                </Button>
            </DataTemplate>
        <converters:MillisecondsToSecondsLabelConverter x:Key="MsToSecondsLabelConverter" />
        <converters:BoolToThicknessConverter x:Key="BoolToThicknessConverter" />
        <converters:BoolToPlayPauseGlyphConverter x:Key="BoolToPlayPauseGlyphConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
    <!-- Output column: left hairline only, full content height; padding insets the preview card. -->
    <Border
        x:Name="OutputPanelChromeBorder"
        MinHeight="0"
        VerticalAlignment="Stretch"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1,1,0,0"
        Padding="16,14,20,16">
                <Grid
                    MinHeight="0"
                    VerticalAlignment="Stretch"
                    RowDefinitions="Auto,Auto,*">
                    <StackPanel
                        x:Name="OutputPreviewAndClearBarsContainer"
                        Spacing="4"
                        VerticalAlignment="Top">
                        <output:ProgramOutputSurface
                            x:Name="ProgramOutputSurfaceHost"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            UseLayoutRounding="True" />

                        <DropDownButton
                            x:Name="PreviewTargetPicker"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Content="{x:Bind ViewModel.ProgramOutput.SelectedPreviewTargetName, Mode=OneWay}"
                            ToolTipService.ToolTip="Preview screen"
                            Visibility="{x:Bind ViewModel.ProgramOutput.PreviewTargetPickerVisibility, Mode=OneWay}">
                            <DropDownButton.Flyout>
                                <MenuFlyout
                                    x:Name="PreviewTargetFlyout"
                                    Placement="BottomEdgeAlignedLeft"
                                    Opening="PreviewTargetFlyout_Opening" />
                            </DropDownButton.Flyout>
                        </DropDownButton>

                        <StackPanel x:Name="OutputClearBarsCard" Spacing="4">
                                <Border
                                    x:Name="SecondaryOutputClearCommandBar"
                                    Height="44"
                                    Background="Transparent"
                                    Visibility="{x:Bind ViewModel.HasSecondaryOutputClearActions, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                                    RightTapped="SecondaryOutputClearCommandBar_RightTapped">
                                    <Grid
                                        Margin="0"
                                        Padding="0"
                                        ColumnDefinitions="*,Auto">
                                        <ItemsControl
                                            Grid.Column="0"
                                            Margin="0"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            ItemsSource="{x:Bind ViewModel.SecondaryOutputClearActions, Mode=OneWay}"
                                            ItemTemplate="{StaticResource ShowOutputClearActionButtonTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <controls:EqualColumnsPanel ColumnSpacing="4" MinimumColumnWidth="64" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                    <Setter Property="VerticalAlignment" Value="Stretch" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                        </ItemsControl>
                                    </Grid>
                                </Border>

                                <Border
                                    x:Name="PrimaryOutputClearCommandBar"
                                    Height="48"
                                    Background="Transparent"
                                    RightTapped="PrimaryOutputClearCommandBar_RightTapped">
                                    <Grid Margin="0" Padding="0">
                                        <ItemsControl
                                            Margin="0"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            ItemsSource="{x:Bind ViewModel.PrimaryOutputClearActions, Mode=OneWay}"
                                            ItemTemplate="{StaticResource ShowOutputClearActionButtonTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <controls:EqualColumnsPanel ColumnSpacing="4" MinimumColumnWidth="64" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                    <Setter Property="VerticalAlignment" Value="Stretch" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Row 1: media transport controls -->
                    <Border
                        x:Name="MediaTransportCardContainer"
                        Grid.Row="1"
                        Margin="0,12,0,0"
                        Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Loaded="MediaTransportCardContainer_Loaded"
                        SizeChanged="MediaTransportCardContainer_SizeChanged"
                        Unloaded="MediaTransportCardContainer_Unloaded">
                        <Grid RowDefinitions="Auto,Auto">
                            <Border Grid.Row="0" Style="{StaticResource ShowPanelSelectorBarHostStyle}">
                            <SelectorBar
                                x:Name="MediaTransportTargetSelectorBar"
                                HorizontalAlignment="Center"
                                AutomationProperties.AutomationId="MediaTransportTargetSelectorBar"
                                SelectionChanged="MediaTransportTargetSelectorBar_SelectionChanged">
                                <SelectorBarItem
                                    x:Name="MediaFilesTransportSelectorItem"
                                    MinWidth="52"
                                    MinHeight="36"
                                    AutomationProperties.AutomationId="MediaFilesTransportSelectorItem"
                                    AutomationProperties.Name="Media files"
                                    Tag="MediaFiles"
                                    ToolTipService.ToolTip="Media Files">
                                    <SelectorBarItem.Icon>
                                        <FontIcon
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                            FontSize="16"
                                            Glyph="&#xE714;" />
                                    </SelectorBarItem.Icon>
                                </SelectorBarItem>
                                <SelectorBarItem
                                    x:Name="AudioFilesTransportSelectorItem"
                                    MinWidth="52"
                                    MinHeight="36"
                                    AutomationProperties.AutomationId="AudioFilesTransportSelectorItem"
                                    AutomationProperties.Name="Audio files"
                                    Tag="AudioFiles"
                                    ToolTipService.ToolTip="Audio Files">
                                    <SelectorBarItem.Icon>
                                        <FontIcon
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                            FontSize="16"
                                            Glyph="&#xE8D6;" />
                                    </SelectorBarItem.Icon>
                                </SelectorBarItem>
                                <SelectorBarItem
                                    x:Name="AnnouncementsTransportSelectorItem"
                                    MinWidth="52"
                                    MinHeight="36"
                                    AutomationProperties.AutomationId="AnnouncementsTransportSelectorItem"
                                    AutomationProperties.Name="Announcements"
                                    Tag="Announcements"
                                    ToolTipService.ToolTip="Announcements">
                                    <SelectorBarItem.Icon>
                                        <FontIcon
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                            FontSize="16"
                                            Glyph="&#xE789;" />
                                    </SelectorBarItem.Icon>
                                </SelectorBarItem>
                            </SelectorBar>
                            </Border>

                            <Border Grid.Row="1" Style="{StaticResource ShowPanelTabContentHostStyle}">
                        <Grid
                            RowDefinitions="Auto,Auto"
                            RowSpacing="14">
                            <!-- Progress and media name -->
                            <Grid
                                Grid.Row="0"
                                RowDefinitions="Auto,Auto"
                                RowSpacing="2">
                                <Slider
                                    x:Name="MediaTransportSeekSlider"
                                    Grid.Row="0"
                                    Margin="0"
                                    VerticalAlignment="Center"
                                    Minimum="0"
                                    Maximum="{x:Bind ViewModel.PlaybackCoordinator.TransportSliderMaximum, Mode=OneWay}"
                                    Value="{x:Bind ViewModel.PlaybackCoordinator.TransportSliderValue, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.PlaybackCoordinator.HasActiveCue, Mode=OneWay}"
                                    IsThumbToolTipEnabled="False"
                                    Loaded="MediaTransportSeekSlider_Loaded"
                                    Unloaded="MediaTransportSeekSlider_Unloaded"
                                    PointerReleased="MediaTransportSeek_PointerReleased"
                                    PointerCaptureLost="MediaTransportSeek_PointerCaptureLost"
                                    ValueChanged="MediaTransportSeek_ValueChanged" />

                                <Grid
                                    Grid.Row="1"
                                    MinHeight="20"
                                    ColumnDefinitions="Auto,*,Auto"
                                    ColumnSpacing="8">
                                    <TextBlock
                                        Grid.Column="0"
                                        MinWidth="36"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        HorizontalTextAlignment="Left"
                                        Text="{x:Bind ViewModel.PlaybackCoordinator.TransportPositionLabel, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        MinWidth="0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        HorizontalTextAlignment="Center"
                                        Text="{x:Bind ViewModel.PlaybackCoordinator.TransportCueName, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                    <TextBlock
                                        Grid.Column="2"
                                        MinWidth="36"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        HorizontalTextAlignment="Right"
                                        Text="{x:Bind ViewModel.PlaybackCoordinator.TransportRemainingLabel, Mode=OneWay}" />
                                </Grid>
                            </Grid>

                            <!-- Transport controls -->
                            <Grid
                                Grid.Row="1"
                                HorizontalAlignment="Center"
                                ColumnDefinitions="Auto,Auto,Auto,Auto"
                                ColumnSpacing="8">
                                <!-- Seek back -->
                                <Button
                                    Grid.Column="0"
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    AutomationProperties.Name="Seek backward"
                                    Command="{x:Bind ViewModel.MediaSeekBackwardCommand, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.PlaybackCoordinator.HasActiveCue, Mode=OneWay}"
                                    Style="{ThemeResource SubtleButtonStyle}"
                                    ToolTipService.ToolTip="Seek backward">
                                    <FontIcon
                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                        FontSize="15"
                                        Glyph="&#xEB9E;" />
                                </Button>
                                <!-- Play / Pause -->
                                <Button
                                    Grid.Column="1"
                                    Width="44"
                                    Height="44"
                                    Padding="0"
                                    AutomationProperties.Name="Play / Pause"
                                    Command="{x:Bind ViewModel.MediaTogglePlayPauseCommand, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.PlaybackCoordinator.HasActiveCue, Mode=OneWay}"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    ToolTipService.ToolTip="Play / Pause">
                                    <FontIcon
                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                        FontSize="17"
                                        Glyph="{x:Bind ViewModel.PlaybackCoordinator.IsPlaying, Converter={StaticResource BoolToPlayPauseGlyphConverter}, Mode=OneWay}" />
                                </Button>
                                <!-- Seek forward -->
                                <Button
                                    Grid.Column="2"
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    AutomationProperties.Name="Seek forward"
                                    Command="{x:Bind ViewModel.MediaSeekForwardCommand, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.PlaybackCoordinator.HasActiveCue, Mode=OneWay}"
                                    Style="{ThemeResource SubtleButtonStyle}"
                                    ToolTipService.ToolTip="Seek forward">
                                    <FontIcon
                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                        FontSize="15"
                                        Glyph="&#xEB9D;" />
                                </Button>
                                <!-- Restart -->
                                <Button
                                    Grid.Column="3"
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    AutomationProperties.Name="Restart"
                                    Command="{x:Bind ViewModel.MediaRestartCommand, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.PlaybackCoordinator.HasActiveCue, Mode=OneWay}"
                                    Style="{ThemeResource SubtleButtonStyle}"
                                    ToolTipService.ToolTip="Restart">
                                    <FontIcon
                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                        FontSize="15"
                                        Glyph="&#xE72C;" />
                                </Button>
                            </Grid>
                        </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border
                        x:Name="ShowControlsCardContainer"
                        Grid.Row="2"
                        MinHeight="260"
                        Margin="0,12,0,0"
                        Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Loaded="ShowControlsCardContainer_Loaded"
                        SizeChanged="ShowControlsCardContainer_SizeChanged"
                        Unloaded="ShowControlsCardContainer_Unloaded">
                        <Grid RowDefinitions="Auto,*">
                            <Border Grid.Row="0" Style="{StaticResource ShowPanelSelectorBarHostStyle}">
                                <SelectorBar
                                    x:Name="ShowControlsSelectorBar"
                                    HorizontalAlignment="Center"
                                    AutomationProperties.AutomationId="ShowControlsSelectorBar"
                                    SelectionChanged="ShowControlsSelectorBar_SelectionChanged">
                                    <SelectorBarItem x:Name="AudioBinSelectorItem" MinHeight="36" MinWidth="48" AutomationProperties.Name="Audio Bin" Tag="audio" ToolTipService.ToolTip="Audio Bin">
                                        <SelectorBarItem.Icon><FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8D6;" /></SelectorBarItem.Icon>
                                    </SelectorBarItem>
                                    <SelectorBarItem x:Name="StageScreensSelectorItem" MinHeight="36" MinWidth="48" AutomationProperties.Name="Stage Screens" Tag="stage" ToolTipService.ToolTip="Stage Screens">
                                        <SelectorBarItem.Icon><FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE7F4;" /></SelectorBarItem.Icon>
                                    </SelectorBarItem>
                                    <SelectorBarItem x:Name="TimersSelectorItem" MinHeight="36" MinWidth="48" AutomationProperties.Name="Timers" Tag="timers" ToolTipService.ToolTip="Timers">
                                        <SelectorBarItem.Icon><FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE823;" /></SelectorBarItem.Icon>
                                    </SelectorBarItem>
                                    <SelectorBarItem x:Name="MessagesSelectorItem" MinHeight="36" MinWidth="48" AutomationProperties.Name="Messages" Tag="messages" ToolTipService.ToolTip="Messages">
                                        <SelectorBarItem.Icon><FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE724;" /></SelectorBarItem.Icon>
                                    </SelectorBarItem>
                                    <SelectorBarItem x:Name="PropsSelectorItem" MinHeight="36" MinWidth="48" AutomationProperties.Name="Props" Tag="props" ToolTipService.ToolTip="Props">
                                        <SelectorBarItem.Icon><FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE7C3;" /></SelectorBarItem.Icon>
                                    </SelectorBarItem>
                                    <SelectorBarItem x:Name="MacrosSelectorItem" MinHeight="36" MinWidth="48" AutomationProperties.Name="Macros" Tag="macros" ToolTipService.ToolTip="Macros">
                                        <SelectorBarItem.Icon><FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE756;" /></SelectorBarItem.Icon>
                                    </SelectorBarItem>
                                </SelectorBar>
                            </Border>

                            <Border
                                Grid.Row="1"
                                MinHeight="0"
                                Style="{StaticResource ShowPanelTabContentHostStyle}">
                                <showControls:ShowControlsPanelView ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

    <!-- East-west resize: same pattern as the media drawer handle (transparent hit target + hover line). -->
    <Border
        x:Name="OutputPanelResizeHandle"
        Width="10"
        Margin="-5,0,0,0"
        HorizontalAlignment="Left"
        VerticalAlignment="Stretch"
        Background="Transparent"
        AutomationProperties.Name="Resize output preview"
        PointerEntered="OutputPanelResize_PointerEntered"
        PointerExited="OutputPanelResize_PointerExited"
        PointerPressed="OutputPanelResize_PointerPressed"
        PointerMoved="OutputPanelResize_PointerMoved"
        PointerReleased="OutputPanelResize_PointerReleased"
        PointerCaptureLost="OutputPanelResize_PointerCaptureLost"
        DoubleTapped="OutputPanelResize_DoubleTapped">
        <Border
            x:Name="OutputPanelResizeHandleHoverLine"
            Width="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            Background="{ThemeResource ShowOutputPanelResizeHoverBrush}"
            Opacity="0">
            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.12" />
            </Border.OpacityTransition>
        </Border>
    </Border>
    </Grid>
</UserControl>
