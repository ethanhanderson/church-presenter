<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ChurchPresenter.Features.Show.Output.ProgramOutputSurface"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ChurchPresenter.Features.Show.Output"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:DataType="local:ProgramOutputSurface"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <!-- Single preview chrome: border, corner radius, and mirror anchor for OperatorPreviewSession. -->
    <Border
        x:Name="PreviewClipHost"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="Black"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Viewbox
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Stretch="{x:Bind ViewModel.OutputStageStretch, Mode=OneWay}">
            <Grid
                Width="{x:Bind ViewModel.FrameWidth, Mode=OneWay}"
                Height="{x:Bind ViewModel.FrameHeight, Mode=OneWay}" />
        </Viewbox>
    </Border>
</UserControl>
